@using System.ComponentModel
@using System.Collections.Specialized

@typeparam TItem
@implements IDisposable

@if (ItemSource.Count == 0 && EmptyContent != null)
{
    @EmptyContent
}
else if (IsNotifyPropertyChangedEnabled)
{
    @foreach (var i in ItemSource.For(Filter))
    {
        <Observable Source="@i">  @ChildContent(i) </Observable>
    }
}
else
{
    @foreach (var i in ItemSource.For(Filter))
    {
        @ChildContent(i)
    }
}
    
@code {

    private IReadOnlyList<TItem> _itemSource;

    [Parameter]
    public RenderFragment<TItem> ChildContent { get; set; }

    [Parameter]
    public RenderFragment? EmptyContent { get; set; }

    [Parameter]
    public bool IsNotifyPropertyChangedEnabled { get; set; }

    [Parameter]
    public Predicate<TItem>? Filter { get; set; }

    [Parameter]
    public IReadOnlyList<TItem> ItemSource
    {
        get => _itemSource;
        set
        {
            if (object.Equals(_itemSource, value)) return;

            if (_itemSource != null && _itemSource is INotifyCollectionChanged npc)
                npc.CollectionChanged -= OnCollectionChanged;
            _itemSource = value;

            if (_itemSource != null && _itemSource is INotifyCollectionChanged npc2)
                npc2.CollectionChanged += OnCollectionChanged;
        }
    }

    private void OnCollectionChanged(object? sender, NotifyCollectionChangedEventArgs e)
    {
        if (_disposed) return;
        _ = this.InvokeAsync(this.StateHasChanged);
    }

    private bool _disposed;

    // The component subscribes to the source's CollectionChanged in the ItemSource setter. Without this Dispose,
    // binding a PROCESS-LIFETIME source (a singleton read model's collection) permanently roots the component's
    // whole render tree: every visit to the page adds one more dead handler, and every fold invokes them all.
    // Found live in the ERP (2026-08-11 UI review, F1). The item-level <Observable> child always disposed
    // correctly — this collection-level subscription was the single gap.
    public void Dispose()
    {
        _disposed = true;
        if (_itemSource is INotifyCollectionChanged npc)
            npc.CollectionChanged -= OnCollectionChanged;
        _itemSource = null!;
    }
}